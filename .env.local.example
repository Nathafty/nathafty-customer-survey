# Copier en .env.local et renseigner les vraies valeurs (ne jamais committer .env.local).

# API Configuration (legacy, non utilisé par le code actuel — à confirmer avant suppression)
NEXT_PUBLIC_API_URL=

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — jamais de préfixe NEXT_PUBLIC_ sur la clé service-role.
SUPABASE_SERVICE_ROLE_KEY=

# nathafty-backoffice — utilisé côté serveur uniquement pour les appels
# server-to-server vers /api/customer/* (BFF, voir CLAUDE.md racine).
BACKOFFICE_API_URL=http://localhost:3001

# Distributor Configuration
NEXT_PUBLIC_DISTRIBUTOR_ID=1

# Environment
NODE_ENV=development
